   "source": [
    "p = float(input('Loan total: '))\n",
    "r = float(input('Monthly interest rate: '))\n",
    "n = float(input('Months to pay off: '))\n",
    "numer = p * r\n",
    "denom = (1-((1+r)**-n))\n",
    "a = (numer/denom)*n\n",
    "print ('Total amount (dollars) needed to pay off loans:',round(a,2))"
   ]
